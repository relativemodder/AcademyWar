<Page x:Class="AcademyWar.PageMain.PageLogin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AcademyWar.PageMain"
      mc:Ignorable="d" 
      Height="350" Width="800"
      Title="PageLogin" Background="White">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Margin="10" Text="Введите логин" />
            <TextBox Margin="10" Name="Login" Width="300" />
            <TextBlock Margin="10" Text="Введите пароль" />
            <PasswordBox Margin="10" Name="Password" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Content="Войти" Padding="15" Margin="5" Background="#FFC1FFA0" Click="LoginButton_Click" />
                <Button Grid.Column="1" Content="Регистрация" Padding="15" Margin="5" Background="#FFF5FFBA" Foreground="#FF8E4100" Click="RegisterButton_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</Page>
